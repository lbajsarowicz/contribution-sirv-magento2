{
    "name": "sirv/magento2",
    "description": "Sirv module for Magento 2",
    "type": "magento2-module",
    "version": "7.3.4",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "require": {
        "magento/module-backend": ">=100.0",
        "magento/module-catalog": ">=100.0"
    },
    "conflict": {
        "magictoolbox/sirv": "*",
        "magictoolbox/magic360": "<1.7.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Sirv\\Magento2\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
